{
  "name": "@terrydada-art/pi-quotas",
  "version": "0.5.1",
  "description": "Quota monitoring for Pi across OpenAI Codex, OpenCode Go, Anthropic, GitHub Copilot, and other providers.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": "Markus Strazds <markus@latentminds.ai>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terrydada-art/pi-quotas.git"
  },
  "homepage": "https://github.com/terrydada-art/pi-quotas#readme",
  "bugs": {
    "url": "https://github.com/terrydada-art/pi-quotas/issues"
  },
  "pi": {
    "extensions": [
      "./src/extensions/core/index.ts",
      "./src/extensions/command-quotas/index.ts",
      "./src/extensions/command-tokens/index.ts",
      "./src/extensions/usage-status/index.ts",
      "./src/extensions/token-status/index.ts",
      "./src/extensions/quota-warnings/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/terrydada-art/pi-quotas/main/docs/quotas-dashboard.png"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mariozechner/pi-coding-agent": "0.61.0",
    "@mariozechner/pi-tui": "0.61.0",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^25.0.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
